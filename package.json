{
  "name": "calver",
  "version": "0.0.0",
  "private": true,
  "description": "GitHub Action to calculate the next Calendar Versioning tag.",
  "license": "MIT",
  "type": "module",
  "packageManager": "pnpm@11.7.0",
  "scripts": {
    "prebuild": "node -e \"require('node:fs').rmSync('dist', { recursive: true, force: true })\"",
    "build": "tsc --noEmit && ncc build src/index.ts -o dist --source-map --license licenses.txt",
    "test": "vitest run",
    "typecheck": "tsc --noEmit"
  },
  "devDependencies": {
    "@types/node": "^20.19.9",
    "@vercel/ncc": "^0.38.3",
    "typescript": "^5.8.3",
    "vitest": "^3.2.4"
  },
  "dependencies": {
    "@actions/core": "^3.0.1"
  }
}
